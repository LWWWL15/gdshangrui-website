// 产品数据定义
// 后续可替换为 API 获取

export interface ProductModel {
  id: string
  model: string // 型号
  cn?: string   // 中文名称（可选）
  mic?: string  // 英文名称（可选）
  vn?: string   // 越南语名称（可选）
  image?: string // 单张图片（已废弃，请使用 images）
  images?: string[] // 多张图片数组
  specs?: {     // 产品参数（待补充）
    keyCn: string
    keyMic: string
    keyVn?: string   // 越南语参数名（可选，缺省回退 valueMic）
    valueCn: string
    valueMic: string
    valueVn?: string // 越南语参数值（可选，缺省回退 valueMic）
  }[]
  features?: {  // 产品特点（待补充）
    cn: string
    mic: string
    vn?: string
  }[]
}

export interface ProductSeries {
  id: string
  cn: string
  mic: string
  vn?: string
  descCn: string
  descMic: string
  descVn?: string
  icon: string
  color: string
  models: ProductModel[]
}

